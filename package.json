{
  "name": "company-landing-page",
  "private": false,
  "version": "3.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "db:generate": "pnpm --filter @workspace/database generate",
    "db:import-cms": "pnpm --filter web import:cms",
    "db:sync-lifeforge": "pnpm --filter web sync:lifeforge-public",
    "db:migrate": "pnpm --filter web exec prisma migrate dev --schema ../../packages/database/prisma/schema.prisma && pnpm --filter web migrate:content-mdx",
    "db:migrate:deploy": "pnpm --filter web exec prisma migrate deploy --schema ../../packages/database/prisma/schema.prisma && pnpm --filter web migrate:content-mdx",
    "db:studio": "pnpm --filter web exec prisma studio --schema ../../packages/database/prisma/schema.prisma",
    "lint": "turbo lint",
    "start": "turbo start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "bin": {
    "company-landing-page": "scripts/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anoopkarnik/company-landing-page.git"
  },
  "keywords": [
    "saas",
    "landing page",
    "cli"
  ],
  "author": "Anoop Karnik",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@next/third-parties": "^15.1.5",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0"
  }
}
